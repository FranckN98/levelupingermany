# Public base URL of the deployed site (used for canonical URLs, OG, sitemap).
NEXT_PUBLIC_SITE_URL=https://eddy-host.com

# WhatsApp contact link used by the hero CTA.
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/

# Password required to access and save content from /admin. Use a long unique value.
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Generated by a Vercel Blob store. Required for durable Vercel persistence.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
